# Copy to .env to override defaults. Every value is optional — the deterministic
# layer (search + metrics + peers + verdict) works with NONE of these set.

# LLM (reasoning layer): written narrative, insights, portfolio Q&A, and Market Pulse.
# Without a key, core analysis remains available and chat is explicitly unavailable.
# Provider-switchable: LLM_PROVIDER = "anthropic" (Claude) or "groq".
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-4-8
# ANTHROPIC_API_KEY=sk-ant-...          # used when LLM_PROVIDER=anthropic
# GROQ_API_KEY=gsk_...                  # used when LLM_PROVIDER=groq (e.g. LLM_MODEL=openai/gpt-oss-120b)

# Web search (Tavily) for the on-demand research agent. Real web research needs BOTH this and
# an LLM key; with either missing, research cleanly no-ops. Free key at https://tavily.com
# HPR_TAVILY_API_KEY=tvly-...
# HPR_SEARCH_DEPTH=basic                # "basic" (1 credit) or "advanced" (2) — cost control
# HPR_SEARCH_DAILY_CAP=60               # hard app-wide ceiling on Tavily calls/day
# HPR_PORTFOLIO_CHAT_DAILY_CAP=100       # per-process ceiling on chat LLM requests/day

# Risk-free rate used for Sharpe / Sortino (annualised). India short-term G-Sec ~6.5%.
# HPR_RISK_FREE_RATE=0.065

# Cache TTLs
# HPR_AMFI_MASTER_TTL_HOURS=24
# HPR_NAV_TTL_HOURS=12
