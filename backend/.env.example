# Copy to .env to override defaults. Every value is optional — the deterministic
# layer (search + metrics + peers + verdict) works with NONE of these set.

# LLM (reasoning layer): Claude-written narrative, web-research claim extraction, and
# (coming) insights + market pulse. Without it, the app uses transparent deterministic text.
# HPR_ANTHROPIC_API_KEY=sk-ant-...
# HPR_LLM_MODEL=claude-opus-4-8

# Web search (Tavily) for the evidence-research agent. Real web research needs BOTH this
# and the Anthropic key above; with either missing, research cleanly no-ops.
# Get a free key at https://tavily.com
# HPR_TAVILY_API_KEY=tvly-...

# Risk-free rate used for Sharpe / Sortino (annualised). India short-term G-Sec ~6.5%.
# HPR_RISK_FREE_RATE=0.065

# Cache TTLs
# HPR_AMFI_MASTER_TTL_HOURS=24
# HPR_NAV_TTL_HOURS=12
